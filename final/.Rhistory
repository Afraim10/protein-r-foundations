library(ggplot2)
library(Peptides)
library(ggrepel)
library(dplyr)
library(tibble)
library(readr)
library(gridExtra)
data("AAdata")
fasta_line <- read_lines("https://rest.uniprot.org/uniprotkb/P00533.fasta")
egfr_seq <- fasta_line[2:length(fasta_line)]
egfr <- paste(egfr_seq, collapse = "")
stopifnot(nchar(egfr) == 1210)
safe_colors <- c("Acidic" = "#454545",
"Aliphatic"  = "#E69F00",
"Aromatic" = "#56B4E9",
"Basic" = "#009E73",
"Charged" = "#F0E442",
"NonPolar" = "#0072B2",
"Polar"= "#D55E00",
"Small"= "#CC79A7",
"Tiny"="#999999")
residue_freq <- Peptides::aaComp(egfr)
residues_table <- data.frame(residue_freq)
residues_long <- residues_table |> rownames_to_column("Category")
residues_long <- residues_long |>
mutate(Category = factor(Category, levels = Category[order(Number)]))
plot3 <- ggplot(residues_long, aes(Category,Number,
label = Number)) +
geom_col(aes(fill = Category), width = 0.5, color = "black", linewidth = 0.3,
show.legend = FALSE) +
labs(x = "Physicochemical category",
y = "Number of residues",
title = "EGFR Residue Composition Across Physicochemical Categories",
subtitle = "Physicochemical categories are not mutually exclusive.") +
scale_fill_manual(values = safe_colors) +
theme_minimal(base_size = 10) +
theme(plot.title = element_text(face = "bold"),
axis.title = element_text(face = "bold"),
axis.text.x = element_text(face = "bold", angle = 45, hjust = 1),
axis.line = element_line(linewidth = 0.5))
egfr_kinase_domain <- substr(egfr, 712, 979)
amino_acids_window <- 20
egfr_kd_length <- nchar(egfr_kinase_domain)
positions <- 1:(egfr_kd_length - amino_acids_window + 1)
hydro_values <- vapply(positions, function(i) {
sub_seq <- substr(egfr_kinase_domain, i, i + amino_acids_window - 1)
hydrophobicity(sub_seq, scale = "KyteDoolittle")
}, numeric(1))
egfr_hydrophob <- data.frame(Position = positions,
Hydrophobicity = hydro_values)
plot4 <- ggplot(egfr_hydrophob, aes(x = Position, y = Hydrophobicity)) +
theme_minimal(base_size = 10) +
geom_line(colour = "#999999", linewidth = 1) +
geom_area( fill = "#0072B2", alpha = 0.3) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "red", linewidth = 0.3) +
labs(title = "EGFR Kinase Domain Local Hydrophobicity Profile",
x = "20-Residue Window Start Position",
y = "Hydrophobicity (Kyte–Doolittle) Scale") +
theme(plot.title    = element_text(face = "bold"),
axis.title    = element_text(face = "bold"),
axis.text.x   = element_text(face = "bold"),
axis.line   = element_line(linewidth = 0.5))
grid.arrange(plot3, plot4, ncol = 2)
#| include: false
Peptides::charge("MTKRCF") # charge(seq, pH = 7, pKscale = "Lehninger")
# where it requires an amino-acids sequence
Peptides::aaList()
args(hydrophobicity)
pI("MTKRCF") # pI(seq, pKscale = "EMBOSS") where it requires an amino-acids sequence,
# must be one of "Bjellqvist", "EMBOSS", "Murray", "Sillero", "Solomon", etc..
str(AAdata$Hydrophobicity$KyteDoolittle)
